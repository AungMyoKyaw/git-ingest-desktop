{
  "name": "git-ingest",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first desktop context builder for AI coding workflows.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "tauri build",
    "package": "tauri build --bundles dmg,app",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:web": "eslint . --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint": "bun run lint:web && bun run lint:rust",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "coverage:web": "vitest run --coverage",
    "test:markers": "node scripts/check-tests.mjs",
    "coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --all-features --workspace --fail-under-lines 100 --fail-under-functions 100 --fail-under-regions 100 --fail-under-branches 100 --html",
    "audit": "cargo audit --file src-tauri/Cargo.lock",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-features && bun run coverage:rust",
    "docs:check": "node scripts/check-docs.mjs",
    "size": "node scripts/size-report.mjs",
    "verify:web": "bun run format:check && bun run lint:web && bun run typecheck && bun run test:markers && bun run coverage:web && bun run build:web",
    "verify": "bun run verify:web && bun run lint:rust && bun run check:rust && bun run audit && bun run docs:check && bun run size",
    "clean": "rm -rf dist coverage src-tauri/target"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/svelte": "5.2.8",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "eslint-plugin-svelte": "3.12.4",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.56.9",
    "svelte-check": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.0.14",
    "vitest": "4.1.10"
  }
}
